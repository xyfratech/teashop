{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "git clone https://github.com/flutter/flutter.git --depth 1 --branch 3.38.7 _flutter",
  "buildCommand": "_flutter/bin/flutter config --enable-web && _flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
